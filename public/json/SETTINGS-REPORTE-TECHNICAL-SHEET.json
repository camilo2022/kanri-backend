            "data_key": "wash_tone_id",
            "show_by_default": false
        },
        "App\\Models\\YokeType": {
            "data": "yoke_types",
            "type": "select",
            "label": "Tipo de Cotilla",
            "data_key": "yoke_type_id",
            "show_by_default": false
        },
        "App\\Models\\Trademark": {
            "data": "trademarks",
            "type": "select",
            "label": "Marca",
            "data_key": "product.trademark_id",
            "show_by_default": true
        },
        "App\\Models\\Collection": {
            "data": "collections",
            "type": "select",
            "label": "Colección",
