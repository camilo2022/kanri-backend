                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "yoke_type": {
                    "label": "Tipo de Cotilla",
                    "data_key": "yoke_type",
                    "display": {
                        "type": "relation",
                        "default": "name",
                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "collection": {
                    "label": "Colección",
