{
    "model": "App\\Models\\TechnicalSheet",
    "fields": {
        "product": {
            "label": "Producto",
            "fields": {
                "reference": {
                    "label": "Referencia",
                    "data_key": "product.code"
                },
                "category_id": {
                    "label": "Categoría",
                    "data_key": "product.subcategory.category.0.name"
                },
                "trademark_id": {
                    "label": "Marca",
                    "data_key": "product.trademark.name"
                },
                "subcategory_id": {
                    "label": "Subcategoría",
                    "data_key": "product.subcategory.name"
                },
                "group": {
                    "label": "Grupo",
                    "data_key": "product.trademark.group.0.name"
                }
            }
        },
        "technical_sheet": {
            "label": "Ficha Técnica",
            "fields": {
                "code": {
                    "label": "Código",
                    "data_key": "code"
                },
                "date": {
                    "label": "Fecha",
                    "data_key": "date",
                    "display": {
                        "type": "date",
                        "default": "d-m-Y",
                        "options": [
                            {
                                "value": "d-m-Y",
                                "label": "dd-mm-yyyy"
                            },
                            {
                                "value": "Y-m-d",
                                "label": "yyyy-mm-dd"
                            },
                            {
                                "value": "d/m/Y",
                                "label": "dd/mm/yyyy"
                            },
                            {
                                "value": "Y/m/d",
                                "label": "yyyy/mm/dd"
                            },
                            {
                                "value": "d-m-y",
                                "label": "dd-mm-yy"
                            },
                            {
                                "value": "d/m/y",
                                "label": "dd/mm/yy"
                            }
                        ]
                    }
                },
                "color": {
                    "label": "Color",
                    "data_key": "color",
                    "display": {
                        "type": "relation",
                        "default": "name",
                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "status": {
                    "label": "Estado",
                    "data_key": "status",
                    "display": {
                        "type": "status",
                        "default": "badge",
                        "styles": {
                            "Pendiente": {
                                "background": "#FEF3C7",
                                "color": "#92400E",
                                "borderLeft": "4px solid #F59E0B"
                            },
                            "En revision": {
                                "background": "#DBEAFE",
                                "color": "#1D4ED8",
                                "borderLeft": "4px solid #3B82F6"
                            },
                            "Aprobado": {
                                "background": "#DCFCE7",
                                "color": "#166534",
                                "borderLeft": "4px solid #22C55E"
                            },
                            "Cancelado": {
                                "background": "#FEE2E2",
                                "color": "#991B1B",
                                "borderLeft": "4px solid #EF4444"
                            }
                        }
                    }
                },
                "subgroup": {
                    "label": "Subgrupo",
                    "data_key": "subgroup.name"
                },
                "back_type": {
                    "label": "Tipo de Trasero",
                    "data_key": "back_type",
                    "display": {
                        "type": "relation",
                        "default": "name",
                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "boot_type": {
                    "label": "Tipo de Bota",
                    "data_key": "boot_type",
                    "display": {
                        "type": "relation",
                        "default": "name",
                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "wash_tone": {
                    "label": "Tono de Lavado",
