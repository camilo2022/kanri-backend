                "observation": {
                    "label": "Observación",
                    "data_key": "observation"
                },
                "garment_type": {
                    "label": "Tipo de Prenda",
                    "data_key": "garment_type",
                    "display": {
                        "type": "relation",
                        "default": "name",
                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "waistband_type": {
                    "label": "Tipo de Pretina",
                    "data_key": "waistband_type",
                    "display": {
                        "type": "relation",
                        "default": "name",
                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "physical_sample": {
                    "label": "Muestra Física",
                    "data_key": "physical_sample",
                    "display": {
                        "type": "boolean",
                        "default": "yes_no",
                        "options": [
                            {
                                "value": "yes_no",
                                "label": "Sí / No"
                            },
                            {
                                "value": "true_false",
                                "label": "True / False"
                            }
                        ]
                    }
                },
                "number_of_buttons": {
                    "label": "Número de Botones",
                    "data_key": "number_of_buttons",
                    "display": {
                        "type": "number",
                        "default": "integer"
                    }
                },
                "measure_of_waistband": {
                    "label": "Medida de Pretina",
                    "data_key": "measure_of_waistband",
                    "display": {
                        "type": "number",
                        "default": "decimal"
                    }
                }
            }
        },
        "process": {
            "label": "Procesos",
            "dynamic": true,
            "url": "/workflow/processes/all",
            "params": {
                "in_technical_sheet": true
            },
            "display": {
                "type": "status",
                "default": "badge",
                "styles": {
                    "_default": {
                        "background": "#F1F5F9",
                        "color": "#64748B"
                    },
                    "Pendiente": {
                        "background": "#FEF3C7",
                        "color": "#92400E",
                        "borderLeft": "4px solid #F59E0B"
                    },
                    "En revision": {
                        "background": "#DBEAFE",
                        "color": "#1D4ED8",
                        "borderLeft": "4px solid #3B82F6"
                    },
                    "Aprobado": {
                        "background": "#DCFCE7",
                        "color": "#166534",
                        "borderLeft": "4px solid #22C55E"
                    }
                }
            }
        }
    },
    "filters": {
        "status": {
            "data": "statusses",
            "type": "select",
            "label": "Estado",
            "data_key": "status",
            "show_by_default": true
        },
        "created_at": {
            "data": "created_at",
            "type": "date_range",
            "label": "Fecha de creación",
            "data_key": "created_at",
            "show_by_default": false
        },
        "App\\Models\\Color": {
            "data": "colors",
            "type": "select",
            "label": "Color",
            "data_key": "color_id",
            "show_by_default": false
        },
        "App\\Models\\Group": {
            "data": "groups",
            "type": "select",
            "label": "Grupo",
            "data_key": "product.trademark.group.id",
            "show_by_default": false
        },
        "App\\Models\\BackType": {
            "data": "back_types",
            "type": "select",
            "label": "Tipo de Trasero",
