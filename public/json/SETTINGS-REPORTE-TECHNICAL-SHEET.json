                        "options": [
                            {
                                "value": "name",
                                "label": "Nombre"
                            },
                            {
                                "value": "code_name",
                                "label": "Código - Nombre",
                                "paths": [
                                    "settings.code",
                                    "name"
                                ],
                                "separator": " - "
                            }
                        ]
                    }
                },
                "created_at": {
                    "label": "Fecha de Creación",
                    "data_key": "created_at",
                    "display": {
                        "type": "date",
                        "default": "d-m-Y h:i A",
                        "options": [
                            {
                                "value": "d-m-Y h:i A",
                                "label": "dd-mm-yyyy hh:mm AM/PM"
                            },
                            {
                                "value": "Y-m-d h:i A",
                                "label": "yyyy-mm-dd hh:mm AM/PM"
                            },
                            {
                                "value": "d/m/Y h:i A",
                                "label": "dd/mm/yyyy hh:mm AM/PM"
                            },
                            {
                                "value": "Y/m/d h:i A",
                                "label": "yyyy/mm/dd hh:mm AM/PM"
                            }
                        ]
                    }
                },
                "updated_at": {
                    "label": "Fecha de Actualización",
                    "data_key": "updated_at",
                    "display": {
                        "type": "date",
                        "default": "d-m-Y h:i A",
                        "options": [
                            {
                                "value": "d-m-Y h:i A",
                                "label": "dd-mm-yyyy hh:mm AM/PM"
                            },
                            {
                                "value": "Y-m-d h:i A",
                                "label": "yyyy-mm-dd hh:mm AM/PM"
                            },
                            {
                                "value": "d/m/Y h:i A",
                                "label": "dd/mm/yyyy hh:mm AM/PM"
                            },
                            {
                                "value": "Y/m/d h:i A",
                                "label": "yyyy/mm/dd hh:mm AM/PM"
                            }
                        ]
                    }
                },
                "description": {
                    "label": "Descripción",
                    "data_key": "description"
